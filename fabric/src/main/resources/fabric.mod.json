{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "contact": {
    "homepage": "https://modrinth.com/mod/phonon",
    "sources": "https://github.com/metrovoc/Phonon",
    "issues": "https://github.com/metrovoc/Phonon/issues"
  },
  "license": "${license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.metrovoc.phonon.PhononFabric"],
    "client": ["com.metrovoc.phonon.client.PhononFabricClient"],
    "modmenu": ["com.metrovoc.phonon.config.PhononModMenu"]
  },
  "mixins": ["phonon.mixins.json", "phonon.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
